# ═══════════════════════════════════════════════════════════════════════════════
# ProjectZeo GII — Environment Configuration Template
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#   nano .env
#
# run.py automatically loads .env on startup.
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# LLM PROVIDERS — Set ONE or more
# ─────────────────────────────────────────────────────────────────────────────

# Default model to use (local Ollama or cloud prefix)
# Ollama examples:   qwen2.5-vl:7b-instruct   llava:13b
# Cloud examples:    anthropic:claude-sonnet-4-20250514   openai:gpt-4o
LLM_MODEL=qwen2.5-vl:7b-instruct

# Anthropic Claude (required if using anthropic:* model)
ANTHROPIC_API_KEY=

# OpenAI GPT / O-series (required if using openai:* model)
OPENAI_API_KEY=

# Ollama server (default: localhost:11434)
PROJECTZEO_OLLAMA_HOST=localhost
PROJECTZEO_OLLAMA_PORT=11434

# ─────────────────────────────────────────────────────────────────────────────
# GII MODE — Core behavior switches
# ─────────────────────────────────────────────────────────────────────────────

# GII execution mode: 0=disabled, 1=basic, 2=full (RECOMMENDED)
PROJECTZEO_GII_MODE=2

# Require GIIController to start (fail-safe: abort if GII unavailable)
PROJECTZEO_REQUIRE_GII=1

# Require LlamaGuard Tier-4 safety classifier
PROJECTZEO_REQUIRE_LLAMAGUARD=0

# Maximum task duration in seconds (90 min default)
PROJECTZEO_MAX_TASK_SECONDS=5400

# Maximum replans before task failure
PROJECTZEO_MAX_REPLANS=3

# ─────────────────────────────────────────────────────────────────────────────
# PERCEPTION — Visual & event-driven observation
# ─────────────────────────────────────────────────────────────────────────────

# Enable V-JEPA 2 predictive world model (requires GPU + vjepa package)
PROJECTZEO_USE_VJEPA=0

# V-JEPA cloud API endpoint (optional — use instead of local GPU)
# PROJECTZEO_VJEPA_ENDPOINT=http://your-vjepa-server:8080

# V-JEPA model variant
PROJECTZEO_VJEPA_MODEL=vjepa2-vitl

# OmniParser weights directory (populated by scripts/install_weights.sh)
PROJECTZEO_WEIGHTS_DIR=~/.projectzeo/weights

# Entity stale timeout in seconds (default: 5s in active mode)
PROJECTZEO_ENTITY_STALE_SECONDS=5.0
PROJECTZEO_ENTITY_STALE_SECONDS_LIGHTWEIGHT=120.0

# Perceptual hash change threshold (bits different = screen changed)
PROJECTZEO_PHASH_THRESHOLD=10

# ─────────────────────────────────────────────────────────────────────────────
# GUI GROUNDING
# ─────────────────────────────────────────────────────────────────────────────

# UI-TARS-2 grounding endpoint (leave empty to use Ollama model)
# PROJECTZEO_UITARS_ENDPOINT=http://localhost:9000

# UI-TARS-2 Ollama model name
PROJECTZEO_UITARS_OLLAMA_MODEL=uitars2:7b

# UI-TARS-2 request timeout
PROJECTZEO_UITARS_TIMEOUT=15

# GUI-Actor confidence threshold for click grounding
PROJECTZEO_GUI_ACTOR_CONF=0.70

# Enable SGLang vision server (faster inference)
PROJECTZEO_USE_SGLANG=0

# ─────────────────────────────────────────────────────────────────────────────
# MEMORY BACKENDS
# ─────────────────────────────────────────────────────────────────────────────

# Memory data directory (SQLite, JSON stores, trajectory archive)
PROJECTZEO_MEMORY_DIR=~/.projectzeo/memory

# Qdrant vector database URL (start with: docker-compose up -d)
PROJECTZEO_QDRANT_URL=http://localhost:6333

# Qdrant collection name
PROJECTZEO_OPENMEM_COLLECTION=projectzeo_openmemory

# Embedding model for semantic search (Ollama model name)
PROJECTZEO_EMBED_MODEL=nomic-embed-text

# HippoRAG knowledge graph path
PROJECTZEO_HIPPORAG_PATH=~/.projectzeo/hipporag.json
PROJECTZEO_HIPPORAG_MAX_NODES=5000
PROJECTZEO_HIPPORAG_PPR_ALPHA=0.85

# Working memory token budget (chars, ~4 tokens per char)
PROJECTZEO_WM_CHAR_BUDGET=4000

# ─────────────────────────────────────────────────────────────────────────────
# ACTIVE INFERENCE / FEP
# ─────────────────────────────────────────────────────────────────────────────

# Number of candidate policies per step
PROJECTZEO_AI_CANDIDATES=4

# Active Inference precision adaptation interval (iterations)
PROJECTZEO_AI_ADAPT_INTERVAL=10

# ─────────────────────────────────────────────────────────────────────────────
# SOAR / OPERATOR CYCLE
# ─────────────────────────────────────────────────────────────────────────────

# Max candidate operators per cycle
PROJECTZEO_OC_MAX_CANDIDATES=5

# TSWM lookahead steps
PROJECTZEO_TSWM_LOOKAHEAD=3

# Consecutive impasses before escalation
PROJECTZEO_IMPASSE_COUNT=3

# LLM propose timeout (seconds)
PROJECTZEO_OC_PROPOSE_TIMEOUT=45

# TSWM evaluation timeout (seconds)
PROJECTZEO_TSWM_TIMEOUT=30

# Minimum operator preference score
PROJECTZEO_OC_MIN_PREF=0.15

# Enable SOAR procedural chunking
PROJECTZEO_CHUNKING=1

# ─────────────────────────────────────────────────────────────────────────────
# LEARNING — Reflexion, GRPO, SPPO, Algorithm Distillation
# ─────────────────────────────────────────────────────────────────────────────

# Algorithm Distillation
PROJECTZEO_AD_ENABLED=1
PROJECTZEO_AD_MAX_EPISODES=5
PROJECTZEO_AD_MAX_STEPS=30
PROJECTZEO_TRAJECTORY_DIR=~/.projectzeo/trajectories

# DICP (Direct In-Context Policy)
PROJECTZEO_DICP_ENABLED=1
PROJECTZEO_DICP_MAX_EXAMPLES=8

# GRPO training
PROJECTZEO_GRPO_ENABLED=1
PROJECTZEO_GRPO_GROUP_SIZE=4
PROJECTZEO_GRPO_BETA=0.01
PROJECTZEO_GRPO_OUTPUT_DIR=~/.projectzeo/grpo
PROJECTZEO_GRPO_MAX_TASKS=50

# ARPO trajectory recording
PROJECTZEO_ARPO_ENABLED=1
PROJECTZEO_ARPO_EWC=1
PROJECTZEO_EWC_BATCH_SIZE=20
PROJECTZEO_TRAINING_DIR=~/.projectzeo/training

# SPPO self-play
PROJECTZEO_SPPO_ENABLED=1

# Agent Q (MCTS preference collection)
PROJECTZEO_AGENT_Q_ENABLED=1
PROJECTZEO_AGENT_Q_DIR=~/.projectzeo/agent_q
PROJECTZEO_AGENT_Q_MAX_PAIRS=500

# Nightly consolidation schedule
PROJECTZEO_CONSOLIDATION_ENABLED=1
PROJECTZEO_CONSOLIDATION_HOUR=3
PROJECTZEO_CONSOLIDATION_MIN_PAIRS=10

# ─────────────────────────────────────────────────────────────────────────────
# SAFETY
# ─────────────────────────────────────────────────────────────────────────────

# Episodic checkpoint interval (steps between checkpoints)
PROJECTZEO_EPISODIC_CHECKPOINT_INTERVAL=50

# Enable milestone decomposition
PROJECTZEO_USE_MILESTONES=1

# Enable persistent world model (Graphiti)
PROJECTZEO_USE_WORLD_MODEL=1

# Enable agent self-model
PROJECTZEO_USE_SELF_MODEL=1

# SNN event processor parameters
PROJECTZEO_SNN_TAU=0.9
PROJECTZEO_SNN_THRESHOLD=1.5
PROJECTZEO_SNN_NEURONS=32

# Popup suspicious window age (seconds)
PROJECTZEO_POPUP_AGE_SEC=3.0

# ─────────────────────────────────────────────────────────────────────────────
# RESTORATION
# ─────────────────────────────────────────────────────────────────────────────

# CRIU process checkpoint directory
PROJECTZEO_CRIU_DIR=~/.projectzeo/criu_dumps
PROJECTZEO_CRIU_MAX_DUMPS=3
PROJECTZEO_CRIU_TIMEOUT=30

# Playwright CDP URL for browser state capture
PROJECTZEO_CDP_URL=http://localhost:9222

# ─────────────────────────────────────────────────────────────────────────────
# VM SANDBOX — For GRPO rollout isolation
# ─────────────────────────────────────────────────────────────────────────────

# Sandbox backend: auto, docker, bwrap, subprocess
PROJECTZEO_SANDBOX_BACKEND=auto

# Sandbox timeout per rollout (seconds)
PROJECTZEO_SANDBOX_TIMEOUT=60

# Memory limit for sandbox container (MB)
PROJECTZEO_SANDBOX_MEM_MB=512

# Docker image for sandbox
PROJECTZEO_SANDBOX_IMAGE=ubuntu:22.04

# GRPO rollout timeout
PROJECTZEO_GRPO_ROLLOUT_TIMEOUT=45

# ─────────────────────────────────────────────────────────────────────────────
# MULTI-AGENT — LangGraph + bBoN
# ─────────────────────────────────────────────────────────────────────────────

# Use LangGraph for agent orchestration
PROJECTZEO_USE_LANGGRAPH=1

# bBoN parallel rollouts (1 = disabled, >1 = parallel; requires multi-display)
PROJECTZEO_BBON_N=1
PROJECTZEO_BBON_ROLLOUT_TIMEOUT=1800

# ─────────────────────────────────────────────────────────────────────────────
# INFRASTRUCTURE URLS
# ─────────────────────────────────────────────────────────────────────────────

# FalkorDB for Graphiti (start with: docker-compose up -d)
PROJECTZEO_FALKORDB_URL=redis://localhost:6379

# Redis event bus
PROJECTZEO_REDIS_URL=redis://localhost:6380

# ─────────────────────────────────────────────────────────────────────────────
# POLICY HOT-RELOAD (Phase 6)
# ─────────────────────────────────────────────────────────────────────────────

# Enable policy.yaml hot-reload without restart
PROJECTZEO_POLICY_HOT_RELOAD=1

# ─────────────────────────────────────────────────────────────────────────────
# USER MODEL
# ─────────────────────────────────────────────────────────────────────────────
PROJECTZEO_USER_MODEL_PATH=~/.projectzeo/user_model.json
PROJECTZEO_USER_MODEL_DECAY=0.95

# ─────────────────────────────────────────────────────────────────────────────
# DISPLAY (Linux headless setup)
# ─────────────────────────────────────────────────────────────────────────────
# Uncomment if running headless with Xvfb:
# DISPLAY=:99
